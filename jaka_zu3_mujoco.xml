<mujoco model="JAKA Zu 3">
  <compiler angle="radian" autolimits="true" meshdir="."/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <statistic center="0.45 0 0.95" extent="2"/>

  <visual>
    <global offwidth="1600" offheight="1200"/>
    <quality shadowsize="2048"/>
  </visual>

  <default>
    <!-- Low node damping lets the cloth flex while remaining numerically stable. -->
    <joint damping="0.2" armature="0.001"/>
    <geom rgba="0.84706 0.84706 0.84706 1"/>
  </default>

  <!-- Run scripts/fetch_assets.sh once to download these upstream assets. -->
  <include file="assets/tabletop/object/floor_isaac_style.xml"/>
  <include file="assets/tabletop/object/object_table.xml"/>
  <include file="assets/objaverse/mug_5/model_new.xml"/>
  <include file="assets/objaverse/plate_11/model_new.xml"/>

  <asset>
    <mesh name="Link_0_mesh" file="assets/jaka_zu3_meshes/Link_0.STL"/>
    <mesh name="Link_1_mesh" file="assets/jaka_zu3_meshes/Link_1.STL"/>
    <mesh name="Link_2_mesh" file="assets/jaka_zu3_meshes/Link_2.STL"/>
    <mesh name="Link_3_mesh" file="assets/jaka_zu3_meshes/Link_3.STL"/>
    <mesh name="Link_4_mesh" file="assets/jaka_zu3_meshes/Link_4.STL"/>
    <mesh name="Link_5_mesh" file="assets/jaka_zu3_meshes/Link_5.STL"/>
    <mesh name="Link_6_mesh" file="assets/jaka_zu3_meshes/Link_6.STL"/>
    <!-- All meshes below are generated from the replacement 装配体2.STL and
         are already in metres. The fixed meshes retain the housing, plates,
         and all fasteners; the moving mesh is the seventh-joint member. -->
    <mesh name="gripper_fixed_housing_mesh" file="assets/gripper/fixed_housing.stl"/>
    <mesh name="gripper_fixed_hardware_a_mesh" file="assets/gripper/fixed_hardware_a.stl"/>
    <mesh name="gripper_fixed_hardware_b_mesh" file="assets/gripper/fixed_hardware_b.stl"/>
    <mesh name="gripper_moving_mesh" file="assets/gripper/moving_jaw.stl"/>
  </asset>

  <worldbody>
    <body name="Link_0" pos="-0.002 0 0.79999">
      <inertial pos="-0.0015666 0.000017294 0.05088" mass="3.6417"
                fullinertia="0.0050627 0.0051147 0.006537 -0.00000069042 -0.000084162 0.0000029665"/>
      <!-- Robot meshes also act as convex-hull collision proxies. Collision
           masks (2/1) allow contact with the scene but suppress robot self-contact. -->
      <geom name="Link_0_visual" type="mesh" mesh="Link_0_mesh" contype="2" conaffinity="1" group="2"/>

      <body name="Link_1" pos="0 0 0.15055">
        <joint name="joint_1" type="hinge" axis="0 0 1" range="-6.28 6.28" damping="30" armature="0.05"/>
        <inertial pos="-0.00000038197 0.0039623 -0.0033438" mass="7.0387"
                  fullinertia="0.012561 0.011919 0.0085506 0.000000081417 -0.000000018051 -0.000087195"/>
        <geom name="Link_1_visual" type="mesh" mesh="Link_1_mesh" contype="2" conaffinity="1" group="2"/>

        <body name="Link_2" pos="0 0 0" euler="1.5708 0 0">
          <joint name="joint_2" type="hinge" axis="0 0 1" range="-1.48 4.62" damping="30" armature="0.05"/>
          <inertial pos="0.11439 -0.00000066036 -0.11395" mass="18.247"
                    fullinertia="0.025431 0.21741 0.20927 0.0000012399 -0.0016148 -0.00000002144"/>
          <geom name="Link_2_visual" type="mesh" mesh="Link_2_mesh" contype="2" conaffinity="1" group="2"/>

          <body name="Link_3" pos="0.248 0 0">
            <joint name="joint_3" type="hinge" axis="0 0 1" range="-3.05 3.05" damping="30" armature="0.05"/>
            <inertial pos="0.13218 0.000012348 -0.0083734" mass="9.5247"
                      fullinertia="0.0094701 0.088902 0.084947 0.00000074928 -0.0012353 0.00000006505"/>
            <geom name="Link_3_visual" type="mesh" mesh="Link_3_mesh" contype="2" conaffinity="1" group="2"/>

            <body name="Link_4" pos="0.228 0.000011925 -0.115">
              <joint name="joint_4" type="hinge" axis="0 0 1" range="-1.48 4.62" damping="30" armature="0.05"/>
              <inertial pos="0.000000065068 -0.014052 0.0031614" mass="3.8728"
                        fullinertia="0.0058546 0.0025893 0.0056328 -0.00000001505 -0.000000017928 -0.00019825"/>
              <geom name="Link_4_visual" type="mesh" mesh="Link_4_mesh" contype="2" conaffinity="1" group="2"/>

              <body name="Link_5" pos="0 -0.1175 0" euler="1.5708 0 0">
                <joint name="joint_5" type="hinge" axis="0 0 1" range="-6.28 6.28" damping="30" armature="0.05"/>
                <inertial pos="0.000000079256 0.0068655 -0.0029086" mass="4.3241"
                          fullinertia="0.007903 0.0028281 0.0076792 0.0000000049677 0.00000001008 -0.00013094"/>
                <geom name="Link_5_visual" type="mesh" mesh="Link_5_mesh" contype="2" conaffinity="1" group="2"/>

                <body name="Link_6" pos="0 0.1065 0" euler="-1.5708 0 0">
                  <joint name="joint_6" type="hinge" axis="0 0 1" range="-6.28 6.28" damping="30" armature="0.05"/>
                  <inertial pos="0.000049731 -0.00002965 -0.016372" mass="0.7876"
                            fullinertia="0.00028184 0.00028506 0.00045635 -0.0000006975 -0.0000004464 0.00000060031"/>
                  <geom name="Link_6_visual" type="mesh" mesh="Link_6_mesh" contype="2" conaffinity="1" group="2"/>
                  <!-- The replacement assembly's circular underside is mapped
                       to the exposed Link_6 flange. Link_6 still rotates the
                       complete tool; joint_7 drives the moving jaw. -->
                  <body name="gripper_base" pos="0 0 0">
                    <!-- Preview mass/inertia estimates; hardware values unknown. -->
                    <inertial pos="0.01 0 0.022" mass="0.45"
                              diaginertia="0.00055 0.00075 0.00070"/>
                    <geom name="gripper_fixed_housing_visual" type="mesh" mesh="gripper_fixed_housing_mesh"
                          rgba="0.86 0.45 0.08 1" contype="2" conaffinity="1" group="2"/>
                    <geom name="gripper_fixed_hardware_a_visual" type="mesh" mesh="gripper_fixed_hardware_a_mesh"
                          rgba="0.24 0.44 0.70 1" contype="2" conaffinity="1" group="2"/>
                    <geom name="gripper_fixed_hardware_b_visual" type="mesh" mesh="gripper_fixed_hardware_b_mesh"
                          rgba="0.24 0.44 0.70 1" contype="2" conaffinity="1" group="2"/>
                    <!-- Source pivot (55.5,36.65,1049) mm becomes this point
                         in the Link_6 flange frame. -->
                    <body name="gripper_moving_jaw" pos="-0.0000184 0.025 0.0549234">
                      <!-- 0 is the closed reference pose; increasing the
                           control rotates the moving jaw out of the housing. -->
                      <joint name="joint_7" type="hinge" axis="0 -1 0"
                             range="0 0.9" damping="0.25" armature="0.0002"/>
                      <inertial pos="0.034 0 0.027" mass="0.08"
                                diaginertia="0.00004 0.00008 0.00006"/>
                      <geom name="gripper_moving_visual" type="mesh" mesh="gripper_moving_mesh"
                            rgba="0.75 0.12 0.58 1" contype="2" conaffinity="1" group="2"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <!-- A light deformable cloth patch, modeled as a 2-D flex grid. -->
    <flexcomp name="rag" type="grid" count="15 11 1" spacing="0.025 0.02 0.01"
              dim="2" pos="0.25 -0.10 0.816" mass="0.10" radius="0.002"
              rgba="0.12 0.40 0.82 1" flatskin="true">
      <edge equality="true"/>
      <contact selfcollide="none" contype="1" conaffinity="1" condim="3"
               friction="1.0 0.01 0.001" solref="0.01 1"
               solimp="0.9 0.95 0.001"/>
    </flexcomp>
  </worldbody>

  <actuator>
    <position name="actuator_joint_1" joint="joint_1" kp="1200" kv="120" ctrlrange="-6.28 6.28" forcerange="-2000 2000"/>
    <position name="actuator_joint_2" joint="joint_2" kp="1200" kv="120" ctrlrange="-1.48 4.62" forcerange="-1500 1500"/>
    <position name="actuator_joint_3" joint="joint_3" kp="1000" kv="100" ctrlrange="-3.05 3.05" forcerange="-1500 1500"/>
    <position name="actuator_joint_4" joint="joint_4" kp="800" kv="80" ctrlrange="-1.48 4.62" forcerange="-1000 1000"/>
    <position name="actuator_joint_5" joint="joint_5" kp="500" kv="50" ctrlrange="-6.28 6.28" forcerange="-1000 1000"/>
    <position name="actuator_joint_6" joint="joint_6" kp="300" kv="30" ctrlrange="-6.28 6.28" forcerange="-1000 1000"/>
    <!-- Simulation gains/torque bounds are provisional, not motor specifications. -->
    <position name="actuator_joint_7" joint="joint_7" kp="18" kv="0.8" ctrlrange="0 0.9" forcerange="-0.8 0.8"/>
  </actuator>

  <!-- Collision-mask scheme: robot/gripper geoms use type 2, environment and
       movable objects use type 1. Both interact with each other, while robot
       links do not collide with other robot links. -->
  <contact>
    <exclude body1="Link_0" body2="Link_1"/>
    <exclude body1="Link_1" body2="Link_2"/>
    <exclude body1="Link_2" body2="Link_3"/>
    <exclude body1="Link_3" body2="Link_4"/>
    <exclude body1="Link_4" body2="Link_5"/>
    <exclude body1="Link_5" body2="Link_6"/>
    <exclude body1="Link_6" body2="gripper_base"/>
    <exclude body1="gripper_base" body2="gripper_moving_jaw"/>
  </contact>

</mujoco>
